      "static/chunks/main-app.js",
      "static/chunks/app/[year]/page.js"
    ],
    "/[year]/[subject]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[year]/[subject]/page.js"
    ],
    "/[year]/[subject]/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[year]/[subject]/layout.js"
    ]
  }
}